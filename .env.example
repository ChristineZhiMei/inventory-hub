# Core HTTP service (custom non-default port)
IH_HOST=127.0.0.1
IH_PORT=18473
IH_DATA_DIR=./inventory-hub-data
IH_SESSION_SECRET=replace-with-at-least-32-random-characters
IH_SETUP_TOKEN=replace-with-a-long-random-setup-token

# Responsive Web development server (custom non-default port)
VITE_PORT=14237
VITE_API_PREFIX=/api/v1

# Docker/Nginx public entry (custom non-default port)
IH_PUBLIC_PORT=19473
