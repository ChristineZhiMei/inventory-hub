  "schema_version":1,"diagram_type":"lifecycle",
  "meta":{"title":"06 · 打印任务状态","locale":"zh-CN","quality_profile":"showcase","viewBox":[1020,650]},
  "lanes":[{"id":"main","label":"任务处理"},{"id":"retry","label":"异常处理"},{"id":"terminal","label":"确认与取消"}],
  "states":[
