# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS builder

WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@9.9.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/core/package.json packages/core/package.json
COPY apps/server/package.json apps/server/package.json
RUN pnpm install --frozen-lockfile

COPY packages/contracts packages/contracts
COPY packages/core packages/core
COPY apps/server apps/server
RUN pnpm build:contracts && pnpm build:core && pnpm --filter @inventory-hub/server build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    IH_APP_MODE=server \
    IH_HOST=0.0.0.0 \
    IH_PORT=18473 \
    IH_DATA_DIR=/var/lib/inventory-hub/database \
    IH_DATABASE_PATH=/var/lib/inventory-hub/database/inventory.sqlite \
    IH_MEDIA_ROOT=/var/lib/inventory-hub/media \
    IH_PRINT_MODE=simulator

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.9.0 --activate \
    && groupadd --gid 10001 inventoryhub \
    && useradd --uid 10001 --gid inventoryhub --no-create-home --shell /usr/sbin/nologin inventoryhub \
    && mkdir -p /var/lib/inventory-hub/database /var/lib/inventory-hub/media \
    && chown -R inventoryhub:inventoryhub /var/lib/inventory-hub

COPY --from=builder --chown=inventoryhub:inventoryhub /workspace/package.json /workspace/pnpm-workspace.yaml ./
COPY --from=builder --chown=inventoryhub:inventoryhub /workspace/node_modules ./node_modules
COPY --from=builder --chown=inventoryhub:inventoryhub /workspace/packages/contracts ./packages/contracts
COPY --from=builder --chown=inventoryhub:inventoryhub /workspace/packages/core ./packages/core
COPY --from=builder --chown=inventoryhub:inventoryhub /workspace/apps/server ./apps/server

USER inventoryhub
EXPOSE 18473
VOLUME ["/var/lib/inventory-hub/database", "/var/lib/inventory-hub/media"]
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=4 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:18473/api/v1/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["node", "apps/server/dist/index.js"]
